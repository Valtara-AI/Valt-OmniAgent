# Example environment variables for Valt OmniAgent
# Copy this to .env.local (or .env.production) and fill values before running

# App
NEXT_PUBLIC_APP_NAME=Valt OmniAgent
NEXT_PUBLIC_API_URL=https://api.omni.valtara.ai

# Next.js runtime
NEXT_PUBLIC_BASE_PATH=

# Auth / External services
AUTH_JWT_SECRET=changeme
NEXTAUTH_URL=https://omni.valtara.ai

# Database (if used)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Analytics / Sentry
SENTRY_DSN=

# Optional: third-party integration keys
LEADCONNECTOR_KEY=

# Port for local production testing
PORT=3000
